  _lines:
  - _speakerName: Suspicious Crystal
    _dialogueText: "The guardians lost their ancient way,\r"
  - _speakerName: Suspicious Crystal
    _dialogueText: "Their eyes from truth have turned away.\r\r"
  - _speakerName: Suspicious Crystal
    _dialogueText: "Face them where the light still gleams - \r\r"
  - _speakerName: Suspicious Crystal
    _dialogueText: "The center stone of fading dreams.\r\r"
