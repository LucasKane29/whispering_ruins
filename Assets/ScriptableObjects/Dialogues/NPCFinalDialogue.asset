  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9d1aef64daab5834a84b1e06c3e1d82d, type: 3}
  m_Name: NPCFinalDialogue
  m_EditorClassIdentifier: 
  _lines:
  - _speakerName: Elder Thomas
    _dialogueText: The Great Worm is no more.
  - _speakerName: Elder Thomas
    _dialogueText: The darkness that gripped these ruins has been broken, and the
      Crystal of Dawn shines once again. Its light reaches every corner of the land,
      driving back the shadows that threatened our world.
  - _speakerName: Elder Thomas
    _dialogueText: You ventured where none dared to go, faced an ancient terror,
      and emerged victorious.
  - _speakerName: Elder Thomas
    _dialogueText: The people will remember this day. The ruins may whisper of forgotten
      ages, but they will also whisper your name.
  - _speakerName: Elder Thomas
    _dialogueText: Today, the Light endures because of you.
