  m_Script: {fileID: 11500000, guid: 9d1aef64daab5834a84b1e06c3e1d82d, type: 3}
  m_Name: NPCDialogue
  m_EditorClassIdentifier: 
  _lines:
  - _speakerName: Elder Thomas
    _dialogueText: The Light is dying, traveler.
  - _speakerName: Elder Thomas
    _dialogueText: Deep beneath these ruins, the Great Worm has awakened.
  - _speakerName: Elder Thomas
    _dialogueText: Its corruption spreads through the ancient tunnels and feeds upon
      the Crystal of Dawn.
  - _speakerName: Elder Thomas
    _dialogueText: If the crystal falls, darkness will claim this world.
  - _speakerName: Elder Thomas
    _dialogueText: Enter the dungeon, defeat the beast, and restore the Light before
      it is too late."
